{"exams":[{"id":"dtm","name":"DTM","scoring":"dtm"},{"id":"ms","nameKey":"nm_ms","scoring":"level"},{"id":"att","nameKey":"nm_att","scoring":"percent"},{"id":"ielts","name":"IELTS","scoring":"ielts"},{"id":"sat","name":"SAT","scoring":"sat"}],"tests":[{"id":"fiz-dtm-1","title":"Fizika 1","subject":"Fizika","exam":"dtm","lang":"uz","duration":20,"premium":false,"shuffle":true,"questions":[{"q":"Jism 5 m/s tezlik bilan tekis harakatlanib, 12 s da qancha masofa bosadi?","o":["17 m","60 m","2,4 m","30 m"],"a":1,"topic":"Kinematika","exp":"Tekis harakatda s = v·t = 5·12 = 60 m."},{"q":"Jism tinch holatdan 2 m/s² tezlanish bilan harakatlanmoqda. 5 s dan keyin uning tezligi qancha?","o":["5 m/s","7 m/s","10 m/s","25 m/s"],"a":2,"topic":"Kinematika","exp":"v = a·t = 2·5 = 10 m/s."},{"q":"Massasi 4 kg bo'lgan jismga 12 N kuch ta'sir qilmoqda. Tezlanishi qancha?","o":["48 m/s²","3 m/s²","8 m/s²","0,33 m/s²"],"a":1,"topic":"Dinamika","exp":"Nyutonning 2-qonuni: a = F/m = 12/4 = 3 m/s²."},{"q":"Massasi 2 kg bo'lgan jism 10 m/s tezlik bilan harakatlanmoqda. Kinetik energiyasi qancha?","o":["20 J","50 J","100 J","200 J"],"a":2,"topic":"Energiya","exp":"E = mv²/2 = 2·100/2 = 100 J."},{"q":"Massasi 3 kg bo'lgan jism 5 m balandlikka ko'tarildi (g = 10 m/s²). Potensial energiyasi qancha?","o":["15 J","150 J","30 J","50 J"],"a":1,"topic":"Energiya","exp":"E = mgh = 3·10·5 = 150 J."},{"q":"Qarshiligi 10 Ω bo'lgan o'tkazgichdan 2 A tok o'tmoqda. Kuchlanish qancha?","o":["5 V","12 V","20 V","0,2 V"],"a":2,"topic":"Elektr","exp":"Om qonuni: U = I·R = 2·10 = 20 V."},{"q":"4 Ω va 6 Ω qarshiliklar ketma-ket ulangan. Umumiy qarshilik qancha?","o":["2,4 Ω","10 Ω","24 Ω","5 Ω"],"a":1,"topic":"Elektr","exp":"Ketma-ket ulanishda R = R₁ + R₂ = 10 Ω."},{"q":"Yorug'likning vakuumdagi tezligi taxminan qancha?","o":["3·10⁶ m/s","3·10⁸ m/s","3·10⁴ m/s","3·10¹⁰ m/s"],"a":1,"topic":"Optika","exp":"c ≈ 3·10⁸ m/s."},{"q":"Gaz doimiy temperaturada siqilsa, uning bosimi qanday o'zgaradi?","o":["Ortadi","Kamayadi","O'zgarmaydi","Avval ortadi, keyin kamayadi"],"a":0,"topic":"Molekulyar fizika","exp":"Boyl–Mariott qonuni: pV = const, hajm kamaysa bosim ortadi."},{"q":"Chastotasi 50 Hz bo'lgan tebranishning davri qancha?","o":["0,5 s","0,02 s","50 s","0,2 s"],"a":1,"topic":"Tebranishlar","exp":"T = 1/ν = 1/50 = 0,02 s."}]},{"id":"fiz-dtm-2","title":"Fizika 2","subject":"Fizika","exam":"dtm","lang":"uz","duration":10,"premium":false,"shuffle":true,"questions":[{"q":"Bosim formulasi qaysi?","o":["p = F·S","p = F/S","p = S/F","p = F + S"],"a":1,"topic":"Bosim","exp":"Bosim kuchning yuzaga nisbatiga teng: p = F/S."},{"q":"Arximed kuchi nimalarga bog'liq?","o":["Suyuqlik zichligi va jismning botgan hajmiga","Faqat jism massasiga","Faqat idish shakliga","Jism rangiga"],"a":0,"topic":"Bosim","exp":"F = ρ·g·V."},{"q":"Ideal gazning holat tenglamasi qaysi?","o":["pV = νRT","p = νRT·V","V = pνRT","pT = νRV"],"a":0,"topic":"Molekulyar fizika","exp":"Mendeleyev–Klapeyron tenglamasi: pV = νRT."},{"q":"Jism 20 m/s tezlik bilan vertikal yuqoriga otildi (g = 10 m/s²). Eng yuqori nuqtaga necha sekundda ko'tariladi?","o":["1 s","2 s","4 s","20 s"],"a":1,"topic":"Kinematika","exp":"t = v/g = 20/10 = 2 s."},{"q":"Tovushning havodagi tezligi taxminan qancha?","o":["34 m/s","340 m/s","3400 m/s","3·10⁸ m/s"],"a":1,"topic":"Tebranishlar","exp":"Havoda tovush tezligi taxminan 340 m/s."}]},{"id":"fiz-ms-1","title":"Fizika: sertifikat 1","subject":"Fizika","exam":"ms","lang":"uz","duration":12,"premium":true,"shuffle":true,"questions":[{"q":"1 kVt·soat necha joulga teng?","o":["3,6·10³ J","3,6·10⁶ J","3,6·10⁹ J","1000 J"],"a":1,"topic":"Energiya","exp":"1 kVt·soat = 1000 W·3600 s = 3,6·10⁶ J."},{"q":"Nyutonning 3-qonuniga ko'ra ta'sir va aks ta'sir kuchlari...","o":["Modul jihatdan teng, yo'nalishi qarama-qarshi","Modul jihatdan teng, yo'nalishi bir xil","Modul jihatdan farq qiladi","Bir jismga qo'yilgan bo'ladi"],"a":0,"topic":"Dinamika","exp":"Kuchlar har xil jismlarga qo'yilgan, modul jihatdan teng, yo'nalishi qarama-qarshi."},{"q":"Zichligi 800 kg/m³ bo'lgan suyuqlikning 0,5 m³ hajmdagi massasi qancha?","o":["400 kg","1600 kg","160 kg","40 kg"],"a":0,"topic":"Dinamika","exp":"m = ρ·V = 800·0,5 = 400 kg."},{"q":"Erkin tushish tezlanishi Yer sirtida taxminan qancha?","o":["1,6 m/s²","9,8 m/s²","98 m/s²","3,7 m/s²"],"a":1,"topic":"Kinematika","exp":"g ≈ 9,8 m/s²."},{"q":"Fokus masofasi 0,5 m bo'lgan linzaning optik kuchi qancha?","o":["0,5 dptr","2 dptr","5 dptr","0,2 dptr"],"a":1,"topic":"Optika","exp":"D = 1/F = 1/0,5 = 2 dptr."},{"q":"600 J ish 20 s da bajarildi. Quvvat qancha?","o":["30 W","12000 W","580 W","3 W"],"a":0,"topic":"Energiya","exp":"N = A/t = 600/20 = 30 W."}]},{"id":"mat-dtm-1","title":"Matematika 1","subject":"Matematika","exam":"dtm","lang":"uz","duration":15,"premium":false,"shuffle":true,"questions":[{"q":"2x + 6 = 18 tenglamani yeching.","o":["x = 4","x = 6","x = 8","x = 12"],"a":1,"topic":"Algebra","exp":"2x = 12, x = 6."},{"q":"x² − 5x + 6 = 0 tenglamaning ildizlari:","o":["1 va 6","2 va 3","−2 va −3","5 va 1"],"a":1,"topic":"Algebra","exp":"Viyet teoremasi: yig'indi 5, ko'paytma 6, demak 2 va 3."},{"q":"Radiusi 7 bo'lgan doiraning yuzi (π = 22/7):","o":["44","154","22","49"],"a":1,"topic":"Geometriya","exp":"S = πr² = (22/7)·49 = 154."},{"q":"240 ning 25 foizi nechaga teng?","o":["50","60","80","24"],"a":1,"topic":"Foiz","exp":"240·0,25 = 60."},{"q":"Arifmetik progressiyada a₁ = 3, d = 4. a₅ nechaga teng?","o":["15","19","23","17"],"a":1,"topic":"Progressiya","exp":"a₅ = a₁ + 4d = 3 + 16 = 19."},{"q":"sin 30° nechaga teng?","o":["√3/2","1/2","1","√2/2"],"a":1,"topic":"Trigonometriya","exp":"sin 30° = 1/2."},{"q":"log₂ 32 nechaga teng?","o":["4","5","6","16"],"a":1,"topic":"Logarifm","exp":"2⁵ = 32, demak 5."},{"q":"Katetlari 6 va 8 bo'lgan to'g'ri burchakli uchburchakning gipotenuzasi:","o":["9","10","12","14"],"a":1,"topic":"Geometriya","exp":"Pifagor teoremasi: √(36+64) = 10."}]},{"id":"geo-dtm-1","title":"Geografiya 1","subject":"Geografiya","exam":"dtm","lang":"uz","duration":8,"premium":false,"shuffle":true,"questions":[{"q":"Yer yuzidagi eng katta okean qaysi?","o":["Atlantika","Hind","Tinch","Shimoliy Muz"],"a":2,"topic":"Okeanlar","exp":"Tinch okean eng katta okeandir."},{"q":"Orol dengizi qaysi ikki davlat hududida joylashgan?","o":["O'zbekiston va Qozog'iston","O'zbekiston va Turkmaniston","Qozog'iston va Qirg'iziston","Tojikiston va Afg'oniston"],"a":0,"topic":"O'rta Osiyo","exp":"Orol dengizi O'zbekiston va Qozog'iston hududida joylashgan."},{"q":"Dunyodagi eng baland tog' cho'qqisi qaysi?","o":["Elbrus","Everest (Jomolungma)","Monblan","Kilimanjaro"],"a":1,"topic":"Relyef","exp":"Everest (Jomolungma) dengiz sathidan eng baland cho'qqi."},{"q":"Amudaryo qadimdan qaysi dengizga quyilgan?","o":["Kaspiy","Qora","Orol","O'rta yer"],"a":2,"topic":"O'rta Osiyo","exp":"Amudaryo Orol dengiziga quyilgan."},{"q":"Sahroi Kabir qaysi qit'ada joylashgan?","o":["Osiyo","Afrika","Avstraliya","Janubiy Amerika"],"a":1,"topic":"Qit'alar","exp":"Sahroi Kabir Afrikada joylashgan."}]},{"id":"eng-ms-1","title":"Ingliz tili: sertifikat 1","subject":"Ingliz tili","exam":"ms","lang":"en","duration":10,"premium":false,"shuffle":true,"questions":[{"q":"If I ___ more time, I would travel the world.","o":["have","had","would have","having"],"a":1,"topic":"Grammar","exp":"Second conditional: If + past simple, would + verb."},{"q":"She has lived in this city ___ 2015.","o":["for","since","from","during"],"a":1,"topic":"Grammar","exp":"'Since' is used with a specific starting point."},{"q":"Choose the word closest in meaning to 'enormous'.","o":["tiny","huge","ordinary","fragile"],"a":1,"topic":"Vocabulary","exp":"Enormous = huge."},{"q":"He suggested ___ to the cinema.","o":["to go","going","go","went"],"a":1,"topic":"Grammar","exp":"'Suggest' is followed by a gerund."},{"q":"I look forward to ___ you next week.","o":["see","seeing","saw","be seeing"],"a":1,"topic":"Grammar","exp":"'Look forward to' is followed by a gerund."},{"q":"By the time we arrived, the film ___.","o":["already started","had already started","has already started","was already starting"],"a":1,"topic":"Grammar","exp":"Past perfect for an earlier completed action."},{"q":"Choose the opposite of 'scarce'.","o":["rare","abundant","limited","poor"],"a":1,"topic":"Vocabulary","exp":"The antonym of scarce is abundant."},{"q":"Neither of the students ___ the answer.","o":["know","knows","are knowing","have known"],"a":1,"topic":"Grammar","exp":"'Neither of' is normally followed by a singular verb."}]},{"id":"ielts-demo-1","title":"IELTS Grammar & Vocabulary demo","subject":"Ingliz tili","exam":"ielts","lang":"en","duration":8,"premium":false,"shuffle":true,"questions":[{"q":"Despite ___ hard, he failed the exam.","o":["study","studying","to study","studied"],"a":1,"topic":"Grammar","exp":"'Despite' is followed by a noun or gerund."},{"q":"What does 'mitigate' mean?","o":["make less severe","make larger","ignore","repeat"],"a":0,"topic":"Vocabulary","exp":"To mitigate is to make something less severe."},{"q":"The report, ___ was published last week, caused debate.","o":["who","which","whose","what"],"a":1,"topic":"Grammar","exp":"'Which' introduces a non-defining clause about a thing."},{"q":"She is accustomed ___ early.","o":["to get up","to getting up","getting up","get up"],"a":1,"topic":"Grammar","exp":"'Be accustomed to' is followed by a gerund."},{"q":"Choose the synonym of 'ubiquitous'.","o":["rare","found everywhere","dangerous","ancient"],"a":1,"topic":"Vocabulary","exp":"Ubiquitous means present everywhere."}]},{"id":"sat-demo-1","title":"SAT Math demo","subject":"Matematika","exam":"sat","lang":"en","duration":6,"premium":false,"shuffle":true,"questions":[{"q":"If 3x + 7 = 22, what is the value of x?","o":["3","5","7","15"],"a":1,"topic":"Algebra","exp":"3x = 15, so x = 5."},{"q":"What is the slope of the line through (1, 2) and (3, 6)?","o":["1","2","3","4"],"a":1,"topic":"Linear functions","exp":"Slope = (6 − 2)/(3 − 1) = 2."},{"q":"If f(x) = 2x² − 3, what is f(4)?","o":["13","29","32","61"],"a":1,"topic":"Functions","exp":"f(4) = 2·16 − 3 = 29."},{"q":"What is 15% of 80?","o":["8","10","12","15"],"a":2,"topic":"Percentages","exp":"0.15 · 80 = 12."}]},{"id":"tar-dtm-1","title":"Tarix 1","subject":"Tarix","exam":"dtm","lang":"uz","duration":8,"premium":false,"shuffle":true,"questions":[{"q":"Amir Temur qaysi yilda tug'ilgan?","o":["1326","1336","1346","1405"],"a":1,"topic":"O'rta asrlar","exp":"Amir Temur 1336-yilda Kesh (Shahrisabz) yaqinida tug'ilgan."},{"q":"Mirzo Ulug'bek rasadxonasi qaysi shaharda qurilgan?","o":["Buxoro","Samarqand","Xiva","Toshkent"],"a":1,"topic":"O'rta asrlar","exp":"Ulug'bek rasadxonasi Samarqandda qurilgan."},{"q":"Al-Xorazmiy qaysi fanning asoschilaridan biri hisoblanadi?","o":["Algebra","Kimyo","Geografiya","Tibbiyot"],"a":0,"topic":"Fan va madaniyat","exp":"Al-Xorazmiy algebra fanining asoschisi hisoblanadi."},{"q":"O'zbekiston Respublikasi mustaqilligi qachon e'lon qilingan?","o":["1990-yil 20-iyun","1991-yil 31-avgust","1991-yil 8-dekabr","1992-yil 8-dekabr"],"a":1,"topic":"Yangi tarix","exp":"Mustaqillik 1991-yil 31-avgustda e'lon qilingan."},{"q":"Buyuk Ipak yo'li qaysi mintaqalarni bog'lagan?","o":["Xitoy va O'rta yer dengizi","Hindiston va Braziliya","Rossiya va Afrika","Yaponiya va Amerika"],"a":0,"topic":"Qadimgi davr","exp":"Ipak yo'li Sharqiy Osiyoni O'rta yer dengizi mintaqasi bilan bog'lagan."}]},{"id":"kim-ms-1","title":"Kimyo: sertifikat 1","subject":"Kimyo","exam":"ms","lang":"uz","duration":6,"premium":true,"shuffle":true,"questions":[{"q":"Tartib raqami 8 bo'lgan element qaysi?","o":["Azot","Kislorod","Uglerod","Neon"],"a":1,"topic":"Davriy jadval","exp":"8-element: kislorod (O)."},{"q":"pH = 7 bo'lgan muhit qanday?","o":["Kislotali","Neytral","Ishqoriy","Tuzli"],"a":1,"topic":"Eritmalar","exp":"pH = 7 neytral muhit."},{"q":"Eng yengil gaz qaysi?","o":["Geliy","Vodorod","Azot","Kislorod"],"a":1,"topic":"Davriy jadval","exp":"Vodorod eng yengil gaz."},{"q":"H₂SO₄ ning nomi nima?","o":["Xlorid kislota","Nitrat kislota","Sulfat kislota","Fosfat kislota"],"a":2,"topic":"Anorganik kimyo","exp":"H₂SO₄ sulfat kislota."},{"q":"CO₂ ning molyar massasi qancha (C = 12, O = 16)?","o":["28 g/mol","32 g/mol","44 g/mol","56 g/mol"],"a":2,"topic":"Hisoblashlar","exp":"12 + 2·16 = 44 g/mol."}]}]}
