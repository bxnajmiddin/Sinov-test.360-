<!doctype html>
<html lang="uz">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sinov: DTM, Milliy sertifikat, IELTS va SAT testlari</title>
<meta name="description" content="DTM, Milliy sertifikat, IELTS va SAT uchun onlayn test mashqlari: taymer, natija tahlili va taxminiy ball.">
<meta property="og:title" content="Sinov: onlayn test mashqlari">
<meta property="og:description" content="DTM, Milliy sertifikat, IELTS va SAT uchun onlayn testlar. Telefonda ishlaydi, bepul.">
<meta property="og:type" content="website">
<meta name="theme-color" content="#0b3c5d">
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
:root{
  --ink:#14202e;--paper:#f3f6f8;--card:#fff;--line:#d6dde5;--muted:#5a6776;
  --blue:#0b3c5d;--teal:#13877b;--teal-soft:#dcf1ee;
  --amber:#b87503;--amber-soft:#fdf0d4;
  --red:#b8332c;--red-soft:#f8dedc;--green:#237a4b;--green-soft:#dcefe3;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.55 system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans","Noto Sans Arabic","Noto Sans Devanagari","PingFang SC","Microsoft YaHei",sans-serif}
h1,h2,h3{font-family:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,"Noto Serif",serif;line-height:1.25;margin:0 0 .5em;letter-spacing:-.01em}
h1{font-size:clamp(26px,5vw,42px)}
h2{font-size:clamp(22px,3.5vw,30px)}
h3{font-size:19px}
p{margin:0 0 .8em}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--teal);outline-offset:2px}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
.muted{color:var(--muted)}
.top{background:var(--card);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20}
.top .wrap{display:flex;align-items:center;gap:14px;min-height:60px;flex-wrap:wrap}
.brand{font-family:"Iowan Old Style",Georgia,serif;font-weight:700;font-size:24px;color:var(--blue);background:none;border:0;padding:0}
.top nav{display:flex;gap:4px;margin-inline-start:auto;flex-wrap:wrap}
.top nav button{background:none;border:0;padding:8px 12px;border-radius:6px;color:var(--muted)}
.top nav button.on{color:var(--blue);background:var(--teal-soft);font-weight:600}
.langsel{width:auto;padding:6px 8px;border:1.5px solid var(--line);border-radius:6px;background:#fff}
main{padding:28px 0 64px}
.btn{border:1px solid var(--blue);background:var(--blue);color:#fff;padding:10px 18px;border-radius:6px;font-weight:600}
.btn:hover{filter:brightness(1.12)}
.btn.alt{background:#fff;color:var(--blue)}
.btn.ghost{border-color:var(--line);background:#fff;color:var(--ink);font-weight:500}
.btn.danger{border-color:var(--red);background:#fff;color:var(--red)}
.btn.sm{padding:6px 12px;font-size:14px}
.btn:disabled{opacity:.45;cursor:not-allowed}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.pill{display:inline-block;padding:2px 10px;border-radius:99px;font-size:13px;font-weight:600}
.p-blue{background:#dbe8f2;color:var(--blue)}
.p-teal{background:var(--teal-soft);color:#0c6b61}
.p-amber{background:var(--amber-soft);color:var(--amber)}
.p-grey{background:#e9edf1;color:var(--muted)}
.panel{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:22px}

/* language gate */
.gate{min-height:100vh;display:grid;place-items:center;padding:24px}
.gate .box{max-width:560px;width:100%;text-align:center}
.langgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-top:22px}
.langgrid button{background:#fff;border:1.5px solid var(--line);border-radius:10px;padding:16px 10px;font-size:18px;font-weight:600}
.langgrid button:hover{border-color:var(--teal);background:var(--teal-soft)}

/* hero */
.hero{display:grid;grid-template-columns:1.1fr 1fr;gap:36px;align-items:center;padding:12px 0 36px}
.hero p.lead{font-size:18px;color:var(--muted);max-width:52ch}
.quick{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:22px}
.quick .q{font-family:"Iowan Old Style",Georgia,serif;font-size:20px;margin-bottom:14px}
.opt{display:flex;gap:12px;align-items:center;width:100%;text-align:start;background:#fff;border:1.5px solid var(--line);border-radius:8px;padding:11px 14px;margin-bottom:9px}
.opt:hover{border-color:var(--teal)}
.opt .ol{flex:none;width:28px;height:28px;border-radius:50%;border:1.5px solid var(--line);display:grid;place-items:center;font-weight:700;font-size:14px;background:var(--paper)}
.opt.on{border-color:var(--blue);background:#eaf2f8}
.opt.on .ol{background:var(--blue);border-color:var(--blue);color:#fff}
.opt.good{border-color:var(--green);background:var(--green-soft)}
.opt.good .ol{background:var(--green);border-color:var(--green);color:#fff}
.opt.bad{border-color:var(--red);background:var(--red-soft)}
.opt.bad .ol{background:var(--red);border-color:var(--red);color:#fff}
.note{font-size:14px;margin-top:6px}

/* grids */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px}
.tcard{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:18px;display:flex;flex-direction:column;gap:6px}
.tcard h3{margin:6px 0 0}
.tcard p{margin:0}
.tcard .best{color:var(--green);font-weight:600;font-size:14px}
.tcard .btn{margin-top:auto;align-self:flex-start}
.xcard{background:var(--card);border:1.5px solid var(--line);border-radius:10px;padding:18px;text-align:start;display:flex;flex-direction:column;gap:4px}
.xcard:hover{border-color:var(--teal)}
.xcard b{font-family:"Iowan Old Style",Georgia,serif;font-size:22px;color:var(--blue)}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 14px}
.chip{border:1px solid var(--line);background:#fff;border-radius:99px;padding:5px 14px;font-size:14px}
.chip.on{background:var(--blue);border-color:var(--blue);color:#fff}

/* exam */
.exambar{background:var(--blue);color:#fff;position:sticky;top:0;z-index:25}
.exambar .wrap{display:flex;align-items:center;gap:14px;min-height:58px;flex-wrap:wrap}
.exambar .t{font-weight:600;flex:1;min-width:140px}
.timer{font-variant-numeric:tabular-nums;font-size:22px;font-weight:700;background:rgba(255,255,255,.14);padding:4px 14px;border-radius:6px;direction:ltr}
.timer.low{background:var(--red)}
.examgrid{display:grid;grid-template-columns:1fr 290px;gap:22px;align-items:start}
.qpane{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:26px}
.qmeta{color:var(--muted);font-size:14px;margin-bottom:8px}
.qtext{font-size:clamp(20px,3vw,25px);margin-bottom:20px;max-width:70ch}
.navbtns{display:flex;gap:10px;justify-content:space-between;flex-wrap:wrap;margin-top:18px}
.navpane{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:18px;position:sticky;top:76px}
.qgrid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin:12px 0}
.qn{aspect-ratio:1;border:1.5px solid var(--line);background:#fff;border-radius:6px;font-weight:600;position:relative}
.qn.done{background:#dbe8f2;border-color:var(--blue);color:var(--blue)}
.qn.cur{outline:3px solid var(--teal);outline-offset:1px}
.qn.flag::after{content:"";position:absolute;top:3px;inset-inline-end:3px;width:9px;height:9px;border-radius:50%;background:var(--amber)}
.legend{font-size:13px;color:var(--muted);display:grid;gap:3px;margin-bottom:12px}
.sw{display:inline-block;width:12px;height:12px;border-radius:3px;border:1.5px solid var(--line);vertical-align:-1px;margin-inline-end:6px}

/* result */
.res{display:grid;grid-template-columns:240px 1fr;gap:28px;align-items:center}
.ring{width:200px;height:200px;border-radius:50%;display:grid;place-items:center;margin:auto}
.ring div{width:156px;height:156px;border-radius:50%;background:#fff;display:grid;place-items:center;text-align:center}
.ring b{font-family:Georgia,serif;font-size:40px;line-height:1}
.bar{height:10px;border-radius:5px;background:var(--line);overflow:hidden}
.bar i{display:block;height:100%;background:var(--teal)}
.bar i.low{background:var(--red)}
.bar i.mid{background:var(--amber)}
.trow{display:grid;grid-template-columns:160px 1fr 54px;gap:12px;align-items:center;margin:9px 0;font-size:15px}
.ai{white-space:pre-wrap;background:var(--teal-soft);border-radius:8px;padding:16px;margin-top:12px}
.rv{border:1px solid var(--line);border-radius:10px;padding:18px;background:#fff;margin-bottom:14px}
.rv.ok{border-inline-start:5px solid var(--green)}
.rv.no{border-inline-start:5px solid var(--red)}
.exp{background:var(--paper);border-radius:6px;padding:10px 12px;font-size:15px;margin-top:8px}

/* tables, forms */
table{width:100%;border-collapse:collapse;background:#fff;border:1px solid var(--line);border-radius:10px;overflow:hidden}
th,td{padding:10px 12px;text-align:start;border-bottom:1px solid var(--line);font-size:15px}
th{background:var(--paper);font-weight:600}
.scroll{overflow-x:auto}
label{display:block;font-weight:600;font-size:14px;margin:12px 0 4px}
input[type=text],input[type=number],select,textarea{width:100%;padding:9px 11px;border:1.5px solid var(--line);border-radius:6px;background:#fff}
textarea{min-height:120px;resize:vertical}
.cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:0 16px}
.opts-edit{display:grid;gap:8px}
.opts-edit div{display:flex;gap:8px;align-items:center}
.opts-edit input[type=radio]{width:20px;height:20px;flex:none}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;margin-bottom:20px}
.stat{background:#fff;border:1px solid var(--line);border-radius:10px;padding:14px 16px}
.stat b{display:block;font-family:Georgia,serif;font-size:28px;line-height:1.1}

/* kitobdan import */
.ctx{white-space:pre-wrap;background:var(--paper);border:1px solid var(--line);border-radius:8px;padding:14px;margin-bottom:16px;max-height:38vh;overflow:auto;font-size:15px;line-height:1.6}
.dz{border:2px dashed var(--line);border-radius:10px;padding:14px;background:#fff}
details summary{cursor:pointer;margin:6px 0}

/* modal + toast */
.ov{position:fixed;inset:0;background:rgba(10,25,40,.55);display:grid;place-items:center;z-index:50;padding:16px}
.modal{background:#fff;border-radius:12px;padding:24px;max-width:460px;width:100%}
#toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:var(--ink);color:#fff;padding:10px 18px;border-radius:8px;opacity:0;pointer-events:none;transition:opacity .2s;z-index:60;max-width:90vw;text-align:center}
#toast.show{opacity:1}

@media(max-width:820px){
  .hero,.res,.examgrid{grid-template-columns:1fr}
  .navpane{position:static}
  .trow{grid-template-columns:110px 1fr 46px}
  .top nav{margin-inline-start:0;width:100%}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>
<div id="app"></div>
<div id="toast" role="status" aria-live="polite"></div>
<input type="file" id="imp" accept="application/json" hidden>

<script>
"use strict";
/* ================= SOZLAMALAR / SETTINGS =================
   TG_BOT      : Telegram bot nomi (@ belgisiz). Telegram orqali kirish tugmasi uchun.
   AI_ENDPOINT : Sizning serveringiz manzili. POST {prompt, lang} -> {text}.
                 Server ichida Claude yoki Gemini chaqiriladi (API kalit serverda saqlanadi).
   ========================================================= */
const CONFIG = { TG_BOT: "", AI_ENDPOINT: "", PREMIUM: false, OWNER_KEY: "o-c79d8a54" };

/* ================= Tillar / Languages ================= */
const LANGS  = ["uz","en","ru","es","fr","pt","ar","zh","hi"];
const NATIVE = ["O'zbekcha","English","Русский","Español","Français","Português","العربية","中文","हिन्दी"];
const AI_LANG= ["Uzbek","English","Russian","Spanish","French","Portuguese","Arabic","Chinese","Hindi"];
/* Har bir qator: [uz, en, ru, es, fr, pt, ar, zh, hi]. Qisqa qator bo'lsa, qolgan tillar inglizcha ko'rsatiladi.
   Yangi til qo'shish: LANGS, NATIVE, AI_LANG ga qo'shing va K dagi har qatorga tarjima qo'shing. */
const K = {
nav_home:["Bosh sahifa","Home","Главная","Inicio","Accueil","Início","الرئيسية","首页","होम"],
nav_tests:["Testlar","Tests","Тесты","Pruebas","Tests","Testes","الاختبارات","测试","टेस्ट"],
nav_results:["Natijalarim","My results","Мои результаты","Mis resultados","Mes résultats","Meus resultados","نتائجي","我的成绩","मेरे परिणाम"],
nav_editor:["Muharrir","Editor","Редактор","Editor","Éditeur","Editor","المحرر","编辑器","एडिटर"],
nav_profile:["Profil","Profile","Профиль","Perfil","Profil","Perfil","الملف الشخصي","个人资料","प्रोफ़ाइल"],
hero_title:["DTM, Milliy sertifikat, IELTS va SAT ga haqiqiy imtihon sharoitida tayyorlaning","Prepare for DTM, national certificates, IELTS and SAT in real exam conditions","Готовьтесь к DTM, национальным сертификатам, IELTS и SAT в условиях настоящего экзамена","Prepárate para DTM, certificados nacionales, IELTS y SAT en condiciones reales de examen","Préparez le DTM, les certificats nationaux, l'IELTS et le SAT en conditions réelles","Prepare-se para DTM, certificados nacionais, IELTS e SAT em condições reais de exame","استعد لاختبارات DTM والشهادات الوطنية وIELTS وSAT في ظروف امتحان حقيقية","在真实考试环境中备考 DTM、国家证书、雅思和 SAT","DTM, राष्ट्रीय प्रमाणपत्र, IELTS और SAT की तैयारी असली परीक्षा जैसे माहौल में करें"],
hero_lead:["Vaqt cheklovi, savollar navigatsiyasi, belgilash imkoni va test oxirida mavzular bo'yicha tahlil.","A timer, question navigator, review flags and a topic-by-topic analysis when you finish.","Таймер, навигация по вопросам, пометки для проверки и анализ по темам после завершения.","Temporizador, navegador de preguntas, marcas para revisar y análisis por temas al terminar.","Minuteur, navigation entre les questions, marques de relecture et analyse par thème à la fin.","Cronômetro, navegação entre questões, marcação para revisar e análise por tema ao terminar.","مؤقت وتنقل بين الأسئلة وعلامات للمراجعة وتحليل حسب المواضيع عند الانتهاء.","计时器、题目导航、标记复查功能,以及完成后按知识点的分析。","टाइमर, प्रश्न नेविगेशन, दोबारा देखने के निशान और अंत में विषय-वार विश्लेषण।"],
btn_browse:["Testlarni ko'rish","Browse tests","Смотреть тесты","Ver pruebas","Voir les tests","Ver testes","تصفح الاختبارات","浏览测试","टेस्ट देखें"],
quick_hint:["Hozir sinab ko'ring: bitta savol, darhol javob","Try it now: one question, instant answer","Попробуйте сейчас: один вопрос, мгновенный ответ","Pruébalo ahora: una pregunta, respuesta inmediata","Essayez : une question, réponse immédiate","Experimente: uma pergunta, resposta imediata","جرّب الآن: سؤال واحد وإجابة فورية","马上试试:一道题,即时反馈","अभी आज़माएँ: एक प्रश्न, तुरंत उत्तर"],
quick_q:["Massasi 2 kg bo'lgan jism 3 m/s² tezlanish bilan harakatlanmoqda. Unga qanday kuch ta'sir qiladi?","A 2 kg body moves with an acceleration of 3 m/s². What force acts on it?","Тело массой 2 кг движется с ускорением 3 м/с². Какая сила на него действует?","Un cuerpo de 2 kg se mueve con una aceleración de 3 m/s². ¿Qué fuerza actúa sobre él?","Un corps de 2 kg a une accélération de 3 m/s². Quelle force s'exerce sur lui ?","Um corpo de 2 kg move-se com aceleração de 3 m/s². Que força atua sobre ele?","جسم كتلته 2 كغ يتحرك بتسارع 3 م/ث². ما القوة المؤثرة عليه؟","质量为 2 kg 的物体以 3 m/s² 的加速度运动,作用在它上面的力是多少?","2 kg द्रव्यमान की वस्तु 3 m/s² त्वरण से चल रही है। उस पर कितना बल लगता है?"],
quick_exp:["Nyutonning 2-qonuni: F = m·a = 2·3 = 6 N.","Newton's second law: F = m·a = 2·3 = 6 N.","Второй закон Ньютона: F = m·a = 2·3 = 6 Н.","Segunda ley de Newton: F = m·a = 2·3 = 6 N.","Deuxième loi de Newton : F = m·a = 2·3 = 6 N.","Segunda lei de Newton: F = m·a = 2·3 = 6 N.","قانون نيوتن الثاني: F = m·a = 2·3 = 6 N.","牛顿第二定律:F = m·a = 2·3 = 6 N。","न्यूटन का दूसरा नियम: F = m·a = 2·3 = 6 N।"],
quick_ok:["To'g'ri.","Correct.","Верно.","Correcto.","Correct.","Correto.","صحيح.","正确。","सही।"],
quick_no:["Noto'g'ri.","Incorrect.","Неверно.","Incorrecto.","Incorrect.","Incorreto.","خطأ.","错误。","गलत।"],
quick_retry:["Qayta urinish","Try again","Ещё раз","Reintentar","Réessayer","Tentar de novo","حاول مرة أخرى","再试一次","फिर कोशिश करें"],
home_exams:["Imtihon yo'nalishlari","Exam tracks","Направления экзаменов","Tipos de examen","Types d'examen","Tipos de exame","مسارات الامتحانات","考试类型","परीक्षा श्रेणियाँ"],
home_feat:["Boshlash uchun testlar","Tests to start with","Тесты для начала","Pruebas para empezar","Tests pour commencer","Testes para começar","اختبارات للبدء","推荐测试","शुरू करने के लिए टेस्ट"],
n_tests:["{n} ta test","{n} tests","Тестов: {n}","{n} pruebas","{n} tests","{n} testes","{n} اختبارات","{n} 个测试","{n} टेस्ट"],
open:["Ochish","Open","Открыть","Abrir","Ouvrir","Abrir","فتح","打开","खोलें"],
all_exams:["Barcha yo'nalishlar","All exams","Все экзамены","Todos los exámenes","Tous les examens","Todos os exames","كل الامتحانات","全部考试","सभी परीक्षाएँ"],
all_subjects:["Barcha fanlar","All subjects","Все предметы","Todas las materias","Toutes les matières","Todas as disciplinas","كل المواد","全部科目","सभी विषय"],
all_langs:["Barcha tillar","All languages","Все языки","Todos los idiomas","Toutes les langues","Todos os idiomas","كل اللغات","全部语言","सभी भाषाएँ"],
no_tests:["Bu bo'limda hali test yo'q.","No tests here yet.","Здесь пока нет тестов.","Aún no hay pruebas aquí.","Aucun test ici pour l'instant.","Ainda não há testes aqui.","لا توجد اختبارات هنا بعد.","这里还没有测试。","यहाँ अभी कोई टेस्ट नहीं है।"],
meta_timed:["{s}: {q} savol, {m} daqiqa","{s}: {q} questions, {m} min","{s}: вопросов {q}, {m} мин","{s}: {q} preguntas, {m} min","{s} : {q} questions, {m} min","{s}: {q} questões, {m} min","{s}: {q} أسئلة، {m} دقيقة","{s}:{q} 题,{m} 分钟","{s}: {q} प्रश्न, {m} मिनट"],
meta_untimed:["{s}: {q} savol, vaqt cheklovsiz","{s}: {q} questions, no time limit","{s}: вопросов {q}, без ограничения времени","{s}: {q} preguntas, sin límite de tiempo","{s} : {q} questions, sans limite de temps","{s}: {q} questões, sem limite de tempo","{s}: {q} أسئلة، بلا حد زمني","{s}:{q} 题,不限时","{s}: {q} प्रश्न, समय सीमा नहीं"],
best:["Eng yaxshi natija: {n}%","Best result: {n}%","Лучший результат: {n}%","Mejor resultado: {n}%","Meilleur résultat : {n} %","Melhor resultado: {n}%","أفضل نتيجة: {n}%","最佳成绩:{n}%","सर्वश्रेष्ठ परिणाम: {n}%"],
start:["Boshlash","Start","Начать","Empezar","Commencer","Começar","ابدأ","开始","शुरू करें"],
